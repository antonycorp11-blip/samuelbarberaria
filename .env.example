# Preencher somente quando for conectar. Nada aqui é usado no modo local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ONESIGNAL_APP_ID=

# Usados só por `npm run test:gmail`, no seu computador. Copie para .env.local.
# NUNCA use o prefixo VITE_ aqui: ele publicaria a senha dentro do app.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Samuel Barbearia

# Em produção estes ficam em `supabase secrets set`:
# GMAIL_USER, GMAIL_APP_PASSWORD, MAIL_FROM_NAME, CRON_SECRET,
# MAIL_DAILY_CAP=400, MAIL_MARKETING_CAP=200,
# ONESIGNAL_APP_ID, ONESIGNAL_REST_API_KEY
